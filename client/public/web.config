<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the UBMV application (React UI + ARR reverse proxy).

  Vite copies this file into client/dist, so it ends up at
  C:\inetpub\wwwroot\UBMV\web.config together with index.html and assets\.

    /UBMV/api/...   -> proxied to the Node API service on http://127.0.0.1:3001
    /UBMV/assets/*  -> served by IIS (static files)
    /UBMV/<other>   -> index.html (single-page app fallback)

  Prerequisites: IIS URL Rewrite 2.1 + Application Request Routing 3.0 with
  "Enable proxy" turned on at server level (see DEPLOYMENT.md).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <clear />

        <!--
          API -> Node. {UNENCODED_URL} is the original path + query string, including the
          /UBMV prefix (e.g. /UBMV/api/todos?x=1); the API is mounted on /UBMV/api, so it is
          forwarded unchanged. Change the port here if you change the service's PORT.
        -->
        <rule name="ApiReverseProxy" stopProcessing="true">
          <match url="^api(/.*)?$" ignoreCase="true" />
          <action type="Rewrite" url="http://127.0.0.1:3001{UNENCODED_URL}" appendQueryString="false" />
        </rule>

        <!-- Real files and folders (index.html, assets/*, favicon...) are served by IIS as-is -->
        <rule name="StaticFiles" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Anything else is a client-side route -> serve the SPA shell -->
        <rule name="SpaFallback" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Let JSON error bodies from the API reach the browser -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

  <!-- Vite emits content-hashed file names in assets/, so they can be cached for a year -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- Always revalidate the SPA shell so new deployments are picked up immediately -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
